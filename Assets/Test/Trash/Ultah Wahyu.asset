  Dialogues:
  - DialogueAudio: {fileID: 8300000, guid: 5de5f58ed6a3c034b81513d593ff8458, type: 3}
    SubtitleType: 1
    SingleSubtitle:
      Time: 0
      Narrator: 
      NarratorColor: {r: 1, g: 1, b: 1, a: 1}
